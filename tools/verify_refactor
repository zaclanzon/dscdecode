#!/usr/bin/env python3
"""Check that the commits BASE..HEAD change no program behavior.

  verify_refactor BASE HEAD [--keep]

Both commits are exported with `git archive` into a scratch directory and
compared in five steps:

  objects   Every tracked .c file under src/, fuzz/ and tests/ is compiled
            from the tree root with a relative path, by gcc and clang at -O0
            and -O2, with -c -std=c11 -Iinclude -Isrc and no -g. The src/
            files are also compiled with the Makefile's release flags without
            -g. An assert.h shim comes first on every include path; it maps
            assert(e) to __builtin_trap() so that __LINE__ and __FILE__ do not
            reach the objects. Each object must be byte-identical.
  build     `make CFLAGS=-O2` (release, no -g) at both commits; dscdecode and
            libdsc.a must be byte-identical (build/release/ or, for commits
            before the build/ layout, the tree root).
  tokens    clang's raw lexer (-dump-raw-tokens) on every tracked .c and .h
            file. The tokens, whitespace included, must rebuild each file. The
            code tokens may differ only by inserted { } pairs; the pairs are
            counted per file and per construct. Preprocessor directives must be
            identical. Any other token change is a difference.
  comments  The comments of every C file, in order: the same text after
            removing whitespace. Comments that differ only in whitespace are
            counted.
  python    ast.dump(ast.parse(...)) of every tracked Python file (*.py and
            files with a python shebang) must be equal.

Tracked files that are neither C nor Python and differ between the commits are
listed; this tool does not verify them.

Exit status: 0 no difference, 1 a difference (the first one of each step is
printed, and the first one overall at the end), 2 usage or setup error.
"""
import argparse
import ast
import collections
import concurrent.futures
import difflib
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

SHIM = '#undef assert\n#define assert(e) ((e) ? (void)0 : __builtin_trap())\n'
COMPILERS = ('gcc', 'clang')
LEVELS = ('-O0', '-O2')
MAKE_FLAGS = ['-Iinclude', '-O2', '-std=c11', '-Wall', '-Wextra', '-Wpedantic', '-Wshadow',
              '-Wconversion']
TOKEN = re.compile(
    r"(\w+) '(.*?)'\t( \[StartOfLine\])?( \[LeadingSpace\])?"
    r"( \[ExpandDisabled\])?( \[UnClean='(.*?)'\])?\tLoc=<[^>]*>\n",
    re.S)


class SetupError(Exception):
    pass


class Report:
    """Collects the first difference of each step."""

    def __init__(self):
        self.first = {}

    def diff(self, step, text):
        print(f'  DIFFERENCE: {text}')
        self.first.setdefault(step, text)


def git(repo, *args):
    p = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, text=True)
    if p.returncode:
        raise SetupError(f'git {" ".join(args)}: {p.stderr.strip()}')
    return p.stdout


def export(repo, rev, dest):
    dest.mkdir(parents=True)
    archive = subprocess.run(['git', '-C', str(repo), 'archive', rev], capture_output=True)
    if archive.returncode:
        raise SetupError(f'git archive {rev}: {archive.stderr.decode().strip()}')
    subprocess.run(['tar', '-x', '-C', str(dest)], input=archive.stdout, check=True)
    return git(repo, 'ls-tree', '-r', '--name-only', rev).split('\n')[:-1]


def is_python(tree, name):
    if name.endswith('.py'):
        return True
    path = tree / name
    try:
        with open(path, 'rb') as f:
            first = f.readline()
    except OSError:
        return False
    return first.startswith(b'#!') and b'python' in first


# --- objects ----------------------------------------------------------------

def compile_one(tree, shim, cc, flags, source, out):
    out.parent.mkdir(parents=True, exist_ok=True)
    p = subprocess.run([cc, '-I', str(shim), *flags, '-c', source, '-o', str(out)],
                       cwd=tree, capture_output=True, text=True)
    return p.returncode, p.stderr


def step_objects(trees, files, shim, work, report):
    print('\n== objects')
    sources = sorted(f for f in files['both'] if f.endswith('.c') and
                     f.split('/')[0] in ('src', 'fuzz', 'tests'))
    jobs = []
    for cc in COMPILERS:
        for level in LEVELS:
            for f in sources:
                jobs.append((f'{cc}{level}', cc, ['-std=c11', '-Iinclude', '-Isrc', level], f))
    for f in sources:
        if f.startswith('src/'):
            jobs.append(('makeflags', 'cc', MAKE_FLAGS, f))
    results = {}
    with concurrent.futures.ThreadPoolExecutor(os.cpu_count() or 4) as pool:
        futures = {}
        for label, cc, flags, f in jobs:
            for side in ('base', 'head'):
                out = work / 'obj' / side / label / (f[:-2] + '.o')
                futures[pool.submit(compile_one, trees[side], shim, cc, flags, f, out)] = \
                    (label, f, side, out)
        for fut in concurrent.futures.as_completed(futures):
            results[futures[fut]] = fut.result()
    same = warnings = 0
    for label, cc, flags, f in jobs:
        outs, statuses = {}, {}
        for side in ('base', 'head'):
            key = next(k for k in results if k[:3] == (label, f, side))
            code, err = results[key]
            statuses[side] = code
            outs[side] = key[3]
            if err.strip():
                warnings += 1
        if statuses['base'] or statuses['head']:
            report.diff('objects', f'{label} {f}: compiler exit status {statuses["base"]} at '
                        f'BASE, {statuses["head"]} at HEAD')
            continue
        a, b = outs['base'].read_bytes(), outs['head'].read_bytes()
        if a != b:
            at = next(i for i in range(min(len(a), len(b)) + 1)
                      if i == min(len(a), len(b)) or a[i] != b[i])
            report.diff('objects', f'{label} {f}: objects differ (sizes {len(a)} and {len(b)}, '
                        f'first differing byte at offset {at})')
        else:
            same += 1
    print(f'  {len(sources)} C sources; {same} of {len(jobs)} object pairs byte-identical '
          f'(gcc and clang at -O0 and -O2, plus Makefile flags for src/); '
          f'{warnings} compiles printed diagnostics')


# --- release build ------------------------------------------------------------

def step_build(trees, report):
    print('\n== build (make CFLAGS=-O2, no -g)')
    outputs = {}
    for side in ('base', 'head'):
        tree = trees[side]
        p = subprocess.run(['make', 'CFLAGS=-O2', 'all'], cwd=tree, capture_output=True, text=True)
        (tree / 'verify-build.log').write_text(p.stdout + p.stderr)
        if p.returncode:
            report.diff('build', f'make failed at {side.upper()}: {(p.stdout + p.stderr)[-300:]}')
            return
        found = {}
        for name in ('dscdecode', 'libdsc.a'):
            for place in (tree / 'build' / 'release' / name, tree / name):
                if place.is_file():
                    found[name] = place
                    break
            else:
                report.diff('build', f'{side.upper()}: make produced no {name}')
                return
        outputs[side] = found
    for name in ('dscdecode', 'libdsc.a'):
        a, b = outputs['base'][name], outputs['head'][name]
        if a.read_bytes() != b.read_bytes():
            report.diff('build', f'{name} differs ({a} vs {b})')
        else:
            print(f'  {name}: byte-identical ({len(a.read_bytes())} bytes)')


# --- tokens and comments -----------------------------------------------------

def lex(tree, shim, path):
    p = subprocess.run(['clang', '-I', str(shim), '-x', 'c', '-std=c11', '-fsyntax-only',
                        '-Xclang', '-dump-raw-tokens', path], cwd=tree, capture_output=True,
                       text=True)
    out = p.stderr
    toks, pos = [], 0
    while pos < len(out):
        m = TOKEN.match(out, pos)
        if not m:
            raise SetupError(f'{tree}/{path}: unparsed lexer output at {out[pos:pos + 80]!r}')
        toks.append((m.group(1), m.group(2), bool(m.group(3)), m.group(7)))
        pos = m.end()
    src = (tree / path).read_text(encoding='utf-8')
    rebuilt = ''.join(u if u is not None else s for _, s, _, u in toks)
    if rebuilt != src:
        raise SetupError(f'{tree}/{path}: the raw tokens do not rebuild the file')
    if any(u is not None for *_, u in toks):
        raise SetupError(f'{tree}/{path}: a token needs cleaning (line continuation)')
    return toks


def is_ws(k, s):
    return k == 'unknown' and s.strip() == ''


def split(toks):
    code = [(k, s) for k, s, _, _ in toks if k != 'comment' and not is_ws(k, s)]
    comments = [s for k, s, _, _ in toks if k == 'comment']
    unknown = [s for k, s, _, _ in toks if k == 'unknown' and s.strip()]
    directives, cur = [], None
    for k, s, sol, _ in toks:
        if cur is None and k == 'hash' and sol:
            cur = []
        if cur is not None:
            if k == 'unknown' and '\n' in s:
                directives.append(tuple(cur))
                cur = None
            elif k != 'comment' and not is_ws(k, s):
                cur.append((k, s))
    if cur is not None:
        directives.append(tuple(cur))
    return code, comments, unknown, directives


def match_braces(seq):
    stack, pairs = [], {}
    for i, (k, _) in enumerate(seq):
        if k == 'l_brace':
            stack.append(i)
        elif k == 'r_brace':
            if not stack:
                return None
            pairs[stack.pop()] = i
    return None if stack else pairs


def construct(seq, i):
    """Name the statement whose body starts at the inserted '{' at i."""
    k, s = seq[i - 1]
    if k == 'raw_identifier' and s in ('else', 'do'):
        return s
    if k == 'r_paren':
        depth, j = 0, i - 1
        while j >= 0:
            if seq[j][0] == 'r_paren':
                depth += 1
            elif seq[j][0] == 'l_paren':
                depth -= 1
                if depth == 0:
                    break
            j -= 1
        return seq[j - 1][1] if j > 0 else 'unknown'
    return f'after {s}'


def show(seq):
    return ' '.join(s for _, s in seq) or '(nothing)'


def compare_code(path, bc, hc, report):
    """Code tokens may differ only by inserted brace pairs. Returns pair count
    and a Counter of the constructs whose bodies they brace."""
    sm = difflib.SequenceMatcher(None, bc, hc, autojunk=False)
    inserted = [False] * len(hc)
    ok = True
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op == 'equal':
            continue
        if op != 'insert' or any(hc[j][0] not in ('l_brace', 'r_brace') for j in range(j1, j2)):
            report.diff('tokens', f'{path}: code token {op}: BASE [{show(bc[i1:i2])}] '
                        f'HEAD [{show(hc[j1:j2])}] (token {i1} at BASE)')
            return None
        for j in range(j1, j2):
            inserted[j] = True
    pairs, base_pairs = match_braces(hc), match_braces(bc)
    if pairs is None or base_pairs is None:
        report.diff('tokens', f'{path}: unbalanced braces')
        return None
    # In a run of consecutive '}', which ones difflib marks as inserted is
    # arbitrary; mark those whose '{' is inserted, with the same count per run.
    partner = {r: l for l, r in pairs.items()}
    j = 0
    while j < len(hc):
        if hc[j][0] != 'r_brace':
            j += 1
            continue
        e = j
        while e < len(hc) and hc[e][0] == 'r_brace':
            e += 1
        want = [inserted[partner[x]] for x in range(j, e)]
        if sum(want) != sum(inserted[j:e]):
            report.diff('tokens', f'{path}: a run of }} at token {j} has {sum(inserted[j:e])} '
                        f'inserted, {sum(want)} with an inserted {{')
            ok = False
        inserted[j:e] = want
        j = e
    count, kinds = 0, collections.Counter()
    for l, r in pairs.items():
        if inserted[l] != inserted[r]:
            report.diff('tokens', f'{path}: inserted brace at token {l if inserted[l] else r} '
                        'is not paired with an inserted brace')
            ok = False
        elif inserted[l]:
            count += 1
            kinds[construct(hc, l)] += 1
    if [t for t, ins in zip(hc, inserted) if not ins] != bc:
        report.diff('tokens', f'{path}: HEAD without the inserted braces is not BASE')
        ok = False
    return (count, kinds) if ok else None


def step_tokens(trees, files, shim, report):
    print('\n== tokens and comments (clang -dump-raw-tokens)')
    paths = sorted(f for f in files['both'] if f.endswith(('.c', '.h')))
    total, kinds = 0, collections.Counter()
    ncode = ncomments = ndirectives = 0
    ws_only = []
    for path in paths:
        bc, bcom, bunk, bdir = split(lex(trees['base'], shim, path))
        hc, hcom, hunk, hdir = split(lex(trees['head'], shim, path))
        if bunk or hunk:
            report.diff('tokens', f'{path}: non-whitespace unknown tokens {bunk} {hunk}')
        result = compare_code(path, bc, hc, report)
        if bdir != hdir:
            first = next((i for i, (a, b) in enumerate(zip(bdir, hdir)) if a != b),
                         min(len(bdir), len(hdir)))
            report.diff('tokens', f'{path}: preprocessor directive {first} differs: BASE '
                        f'[{show(bdir[first]) if first < len(bdir) else "none"}] HEAD '
                        f'[{show(hdir[first]) if first < len(hdir) else "none"}]')
        squash = lambda c: re.sub(r'\s+', '', c)
        if [squash(c) for c in bcom] != [squash(c) for c in hcom]:
            first = next((i for i, (a, b) in enumerate(zip(bcom, hcom))
                          if squash(a) != squash(b)), min(len(bcom), len(hcom)))
            report.diff('comments', f'{path}: comment {first} differs beyond whitespace: '
                        f'BASE {bcom[first] if first < len(bcom) else None!r} '
                        f'HEAD {hcom[first] if first < len(hcom) else None!r}')
        else:
            n = sum(a != b for a, b in zip(bcom, hcom))
            if n:
                ws_only.append((path, n))
        if result:
            total += result[0]
            kinds += result[1]
            print(f'  {path}: {len(bc)} code tokens at BASE, {result[0]} inserted brace pairs, '
                  f'{len(bcom)} comments, {len(bdir)} directives')
        ncode += len(bc)
        ncomments += len(bcom)
        ndirectives += len(bdir)
    print(f'  {len(paths)} files: {ncode} code tokens, {ncomments} comments, '
          f'{ndirectives} directives at BASE')
    print(f'  inserted brace pairs: {total}' +
          (' (' + ', '.join(f'{k} {v}' for k, v in kinds.most_common()) + ')' if total else ''))
    print('  comments differing only in whitespace: ' +
          (', '.join(f'{p} {n}' for p, n in ws_only) if ws_only else 'none'))


# --- Python ------------------------------------------------------------------

def step_python(trees, files, report):
    print('\n== python (ast.dump)')
    paths = sorted(f for f in files['both'] if is_python(trees['base'], f) or
                   is_python(trees['head'], f))
    for path in paths:
        dumps = []
        for side in ('base', 'head'):
            source = (trees[side] / path).read_text(encoding='utf-8')
            try:
                dumps.append(ast.dump(ast.parse(source, filename=path)))
            except SyntaxError as e:
                dumps.append(f'SyntaxError: {e}')
        if dumps[0] != dumps[1]:
            at = next(i for i in range(min(map(len, dumps)) + 1)
                      if i == min(map(len, dumps)) or dumps[0][i] != dumps[1][i])
            report.diff('python', f'{path}: syntax trees differ near '
                        f'BASE ...{dumps[0][max(0, at - 40):at + 40]}... '
                        f'HEAD ...{dumps[1][max(0, at - 40):at + 40]}...')
        else:
            print(f'  {path}: equal')
    print(f'  {len(paths)} Python files')


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('base')
    ap.add_argument('head')
    ap.add_argument('--keep', action='store_true', help='keep the scratch directory')
    a = ap.parse_args()
    repo = Path(__file__).resolve().parent.parent
    for tool in ('gcc', 'clang', 'make', 'cc'):
        if not shutil.which(tool):
            print(f'ERROR: {tool} not found', file=sys.stderr)
            return 2
    work = Path(tempfile.mkdtemp(prefix='verify-refactor-'))
    report = Report()
    try:
        revs = {side: git(repo, 'rev-parse', '--verify', f'{rev}^{{commit}}').strip()
                for side, rev in (('base', a.base), ('head', a.head))}
        print(f'BASE {revs["base"]}\nHEAD {revs["head"]}\nscratch {work}')
        shim = work / 'shim'
        shim.mkdir()
        (shim / 'assert.h').write_text(SHIM)
        trees, listing = {}, {}
        for side in ('base', 'head'):
            trees[side] = work / side
            listing[side] = set(export(repo, revs[side], trees[side]))
        files = dict(both=listing['base'] & listing['head'])
        print('\n== files')
        code = lambda f: f.endswith(('.c', '.h')) or is_python(trees['base'], f) or \
            is_python(trees['head'], f)
        for side, other in (('base', 'head'), ('head', 'base')):
            for f in sorted(listing[side] - listing[other]):
                if code(f):
                    report.diff('files', f'{f} exists only at {side.upper()}')
        changed = [f for f in sorted(files['both']) if not code(f) and
                   (trees['base'] / f).read_bytes() != (trees['head'] / f).read_bytes()]
        only = sorted((listing['base'] ^ listing['head']) - {f for f in listing['base'] |
                                                              listing['head'] if code(f)})
        print('  other files that differ (not verified here): ' +
              (', '.join(changed + only) if changed or only else 'none'))
        for line in subprocess.run(['grep', '-rnE', r'__(LINE|FILE|DATE|TIME)__', 'src', 'fuzz',
                                    'tests', 'include'], cwd=trees['head'], capture_output=True,
                                   text=True).stdout.splitlines():
            print(f'  note: {line} (can reach objects; the object step may report it)')
        step_objects(trees, files, shim, work, report)
        step_build(trees, report)
        step_tokens(trees, files, shim, report)
        step_python(trees, files, report)
    except SetupError as e:
        print(f'ERROR: {e}', file=sys.stderr)
        return 2
    finally:
        if a.keep:
            print(f'\nscratch kept: {work}')
        else:
            shutil.rmtree(work, ignore_errors=True)
    print('\n== result')
    steps = ('files', 'objects', 'build', 'tokens', 'comments', 'python')
    for step in steps:
        print(f'  {step}: {"DIFFERENCE" if step in report.first else "same"}')
    if report.first:
        step = next(s for s in steps if s in report.first)
        print(f'FIRST DIFFERENCE ({step}): {report.first[step]}')
        print('RESULT: FAIL')
        return 1
    print('RESULT: PASS')
    return 0


if __name__ == '__main__':
    sys.exit(main())
