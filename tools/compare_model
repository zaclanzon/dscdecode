#!/usr/bin/env python3
"""Compare dscdecode with the VESA DSC reference model, used as a black box.

  compare_model image IMAGE [options]      model encodes IMAGE; the model and
                                           dscdecode both decode its bitstream
  compare_model bitstream PPS BIN [opts]   the model and dscdecode decode a
                                           raw PPS plus payload
  compare_model discriminators [NAME...]   the model decodes each input in
                                           tests/discriminators; report which
                                           predicted output it matches
  compare_model --self-test                one small image comparison

The model binary comes from DSCDECODE_MODEL_BIN. If that is unset, every mode
prints SKIP and exits 77, which scripts/ci.sh counts as a pass.

dscdecode is the release build, build/release/dscdecode (make). --build
sanitize, or DSCDECODE_BUILD=sanitize, selects the ASan/UBSan build,
build/sanitize/dscdecode (make build/sanitize/dscdecode). DSCDECODE_BIN names
any other binary and takes precedence. Every mode prints the path it uses.

The model's interface is taken only from its README.TXT, its .cfg files, and
the files it writes. Its .dsc files are the 4 bytes "DSCF", the 128-byte PPS,
then the payload in DSC 1.1 §4.2.2 order: slice rows, then lines, then one
chunk per horizontal slice. That is the same order dscdecode reads.

Every run happens in a fresh directory under ~/dsc-runs/compare (override
with DSCDECODE_RUNS). Model output never enters the repository.

Exit status: 0 match, 1 mismatch, 2 error, 77 SKIP. In discriminators mode,
an input the model matches to neither prediction counts as a mismatch unless
it was built assuming readings (manifest `assumes`) that the decoder no
longer defaults to; it is then reported as inconclusive. An input the
manifest marks `superseded_by` another is still decoded, for the record, but
is reported as SUPERSEDED and left out of the verdict and the exit status.
"""
import argparse
import datetime
import itertools
import json
import os
import re
from pathlib import Path
import shutil
import subprocess
import sys

REPO = Path(__file__).resolve().parent.parent
SKIP = 77
MAGIC = b'DSCF'
READINGS = {
    'flat_restart': ('next-cycle', 'in-flight'),
    'threshold_eq': ('lower', 'upper'),
    'frac_reset': ('chunk', 'literal'),
    'delay_offset': ('inclusive', 'exclusive'),
    'bp_left': ('replicate', 'midpoint'),
    'bp_edge': ('window', 'before'),
    'bp_sad': ('shift', 'clip'),
    'incr_order': ('printed', 'swapped'),
    'rc_pipeline': ('same-group', 'range-lag'),
    'scale_dec': ('from-group-1', 'from-group-0'),
    'partial_target': ('three', 'pixels'),
    'very_flat': ('group-qp', 'as-signaled', 'previous-qp'),
    'partial_padding': ('reject', 'accept'),
    'flat_max_qp': ('own', 'previous'),
    'delay_partial': ('pixels', 'group-end'),
    'bpg_combine': ('replace', 'add'),
    'chroma_qlevel': ('table', 'equal-depth'),
    'prefix16': ('15', '13'),
    'bitsave_ich': ('not', 'set'),
    'bitsave_pred': ('raw', 'adjusted', 'next'),
    'bitsave_flat': ('supergroup', 'group', 'received', 'carrier', 'span', 'lagged'),
    'line_flat': ('very', 'signaled'),
    'low_min': ('max-qp', 'min-qp'),
    'decrement_test': ('both', 'size'),
    'activity_qp': ('prev', 'prev2'),
    'bitsave_step': ('1', '2'),
    'target_floor': ('none', 'zero'),
    'flat_rerun': ('changed', 'every'),
    'rerun_bitsave': ('keep', 'redo'),
    'mux16': ('68', '64'),
    'flat_top': ('equal', 'at-or-above'),
    'prefix16_scope': ('qp0', 'qlevel'),
    'prefix16_cut': ('always', 'longer'),
}
RC_NAME = re.compile(r'rc_(\d+)bpc_(\d+)bpp\.cfg$')


class HarnessError(Exception):
    pass


# --- images ----------------------------------------------------------------

def read_pnm(path):
    """Binary PPM (P6), any maxval, comments allowed. Returns (w, h, maxval,
    body); samples above maxval 255 take two bytes, most significant first."""
    data = Path(path).read_bytes()
    fields, pos = [], 0
    while len(fields) < 4:
        while pos < len(data) and data[pos:pos + 1].isspace():
            pos += 1
        if data[pos:pos + 1] == b'#':
            pos = data.index(b'\n', pos) + 1
            continue
        end = pos
        while end < len(data) and not data[end:end + 1].isspace():
            end += 1
        fields.append(data[pos:end])
        pos = end
    if fields[0] != b'P6' or not 0 < int(fields[3]) <= 65535:
        raise HarnessError(f'{path}: not a binary PPM')
    w, h, maxval = int(fields[1]), int(fields[2]), int(fields[3])
    size = 3 * w * h * (2 if maxval > 255 else 1)
    body = data[pos + 1:pos + 1 + size]
    if len(body) != size:
        raise HarnessError(f'{path}: truncated')
    return w, h, maxval, body


def read_ppm(path):
    """Binary PPM (P6), maxval <= 255, comments allowed. Returns (w, h, rgb)."""
    w, h, maxval, body = read_pnm(path)
    if maxval > 255:
        raise HarnessError(f'{path}: not an 8-bit binary PPM')
    return w, h, body


def samples(maxval, body):
    if maxval <= 255:
        return body
    return [body[i] << 8 | body[i + 1] for i in range(0, len(body), 2)]


def image_size(path):
    """(width, height) of a source image the model reads: PPM or DPX."""
    path = Path(path)
    head = path.read_bytes()[:1024]
    if head[:4] in (b'SDPX', b'XPDS'):
        order = 'big' if head[:4] == b'SDPX' else 'little'
        return (int.from_bytes(head[772:776], order), int.from_bytes(head[776:780], order))
    w, h, _, _ = read_pnm(path)
    return w, h


def to_maxval(maxval, body, target):
    """The samples of a PNM body written at a larger maxval, back at the
    smaller one. The model writes 14-bit pictures as 16-bit PPM, each sample
    v as floor(v * 65535 / 16383). Each value is mapped back and checked to
    map forward to the same value; returns None if one does not."""
    if not 0 < target < maxval:
        return None
    out = []
    for value in samples(maxval, body):
        v = value * target // maxval
        if v * maxval // target != value:
            v += 1
        if v > target or v * maxval // target != value:
            return None
        out.append(v)
    return out


def compare_images(expected_path, actual_path):
    """First differing sample and counts. Expected is the model's output."""
    ew, eh, em, e = read_pnm(expected_path)
    aw, ah, am, a = read_pnm(actual_path)
    if (ew, eh) != (aw, ah):
        return dict(match=False, size_mismatch=[ew, eh, aw, ah])
    if em > am and to_maxval(em, e, am) is not None:
        e, em, a = to_maxval(em, e, am), am, samples(am, a)
    if em != am:
        return dict(match=False, maxval_mismatch=[em, am])
    if e != a and isinstance(e, bytes):
        e, a = samples(em, e), samples(am, a)
    diffs = [i for i in range(len(e)) if e[i] != a[i]] if e != a else []
    result = dict(match=not diffs, samples_differing=len(diffs),
                  pixels_differing=len({i // 3 for i in diffs}))
    if diffs:
        i = diffs[0]
        result['first'] = dict(x=(i // 3) % ew, y=(i // 3) // ew, component='RGB'[i % 3],
                               expected=e[i], actual=a[i])
    return result


def describe(result):
    if 'model_error' in result:
        return result['model_error']
    if 'error' in result:
        return 'dscdecode error: ' + result['error'].strip().splitlines()[-1]
    if result.get('size_mismatch'):
        return 'size mismatch: model {}x{}, dscdecode {}x{}'.format(*result['size_mismatch'])
    if result.get('maxval_mismatch'):
        return 'maxval mismatch: model {}, dscdecode {}'.format(*result['maxval_mismatch'])
    if result['match']:
        return 'match (bit-exact)'
    f = result['first']
    return (f"MISMATCH first at x={f['x']} y={f['y']} {f['component']} "
            f"expected(model)={f['expected']} actual(dscdecode)={f['actual']}; "
            f"{result['samples_differing']} samples in {result['pixels_differing']} pixels differ")


# --- the model, as a black box ---------------------------------------------

class Model:
    def __init__(self, run_dir):
        self.bin = os.environ.get('DSCDECODE_MODEL_BIN')
        if not self.bin:
            print('SKIP: DSCDECODE_MODEL_BIN is not set')
            sys.exit(SKIP)
        self.cfg_dir = Path(os.environ.get('DSCDECODE_MODEL_CFG_DIR', '/usr/local/share/dsc-ref'))
        self.dir = run_dir
        self.dir.mkdir(parents=True, exist_ok=True)
        self.encode_signal = None

    def run(self, cfg_name, cfg_text, list_lines, done_file=None):
        (self.dir / f'{cfg_name}.list').write_text(''.join(l + '\n' for l in list_lines))
        (self.dir / f'{cfg_name}.cfg').write_text(cfg_text.replace('@LIST@', f'{cfg_name}.list'))
        p = subprocess.run([self.bin, '-F', f'{cfg_name}.cfg'], cwd=self.dir,
                           capture_output=True, text=True, timeout=1800)
        (self.dir / f'{cfg_name}.log').write_text(p.stdout + p.stderr)
        # At 14 bpc the model's encoder dies from a signal while shutting
        # down, after it has written every output (PROGRESS.md, M3 Phase 4).
        # Such an encode is accepted, and recorded, only when its log reports
        # the last slice and the output file exists; the model's own decode of
        # the bitstream then runs as a separate process.
        slices = re.findall(r'Processing slice (\d+) / (\d+)', p.stdout)
        if (p.returncode < 0 and done_file and (self.dir / done_file).exists() and slices and
                slices[-1][0] == slices[-1][1]):
            self.encode_signal = -p.returncode
        elif p.returncode:
            raise HarnessError(f'model {cfg_name} failed ({p.returncode}): {(p.stdout + p.stderr)[-400:]}')
        return p.stdout

    def rc_file(self, bpc, bpp):
        """rc_<bpc>bpc_<bpp>bpp.cfg, or the one with the nearest rate."""
        rates = sorted(int(m.group(2)) for m in (RC_NAME.match(f.name)
                                                 for f in self.cfg_dir.glob('rc_*.cfg'))
                       if m and int(m.group(1)) == bpc)
        if not rates:
            raise HarnessError(f'no rc_{bpc}bpc_*bpp.cfg in {self.cfg_dir}')
        return f'rc_{bpc}bpc_{min(rates, key=lambda b: abs(b - bpp))}bpp.cfg'

    def encode(self, image, bpp, slices, slice_height, block_pred, line_buffer, bpc=8, version=1):
        w, h = image_size(image)
        link = self.dir / ('input' + Path(image).suffix.lower())
        if not link.exists():
            link.symlink_to(Path(image).resolve())
        template = (self.cfg_dir / 'test_dsc_1_1.cfg').read_text()
        rc = self.rc_file(bpc, bpp)
        shutil.copy(self.cfg_dir / rc, self.dir / rc)
        settings = dict(DSC_VERSION_MINOR=str(version), FUNCTION='1', SRC_LIST='@LIST@',
                        PPM_FILE_OUTPUT='1', BLOCK_PRED_ENABLE=str(int(block_pred)),
                        VBR_ENABLE='0', USE_YUV_INPUT='0', SIMPLE_422='0',
                        NATIVE_422='0', NATIVE_420='0',
                        LINE_BUFFER_BPC=str(line_buffer),
                        SLICE_WIDTH=str(-(-w // slices)),
                        BITS_PER_PIXEL=f'{bpp:g}')
        if Path(image).suffix.lower() == '.dpx':
            # tools/make_pictures writes DPX in the layout the model writes
            # with these settings, and reads back unchanged.
            settings.update(SWAP_R_AND_B='0', DPXR_DATUM_ORDER='1', DPXR_PAD_ENDS='1')
        if slice_height:
            settings['SLICE_HEIGHT'] = str(slice_height)
        self.run('encode', edit_cfg(template, settings, rc), [link.name], done_file='input.dsc')
        dsc = self.dir / 'input.dsc'
        if not dsc.exists():
            raise HarnessError('model wrote no input.dsc')
        return dsc

    def check_source(self, image):
        """Compare the model's view of its input (input.ref.ppm) with the
        master PPM that tools/make_pictures writes beside a DPX picture."""
        master = Path(image).parent / 'master' / (Path(image).stem + '.ppm')
        ref = self.dir / 'input.ref.ppm'
        if not master.exists():
            return None
        if not ref.exists():
            raise HarnessError('model wrote no input.ref.ppm to check its input against')
        mw, mh, mm, mb = read_pnm(master)
        rw, rh, rm, rb = read_pnm(ref)
        same = (mw, mh) == (rw, rh) and (
            (mm, mb) == (rm, rb) or (rm > mm and to_maxval(rm, rb, mm) == samples(mm, mb)))
        if not same:
            raise HarnessError(f'the model read {image} differently from {master}')
        return 'match' 

    def decode(self, dsc):
        self.run('decode', 'FUNCTION 2\nSRC_LIST @LIST@\nPPM_FILE_OUTPUT 1\n', [dsc.name])
        out = self.dir / (dsc.stem + '.out.ppm')
        if not out.exists():
            raise HarnessError(f'model wrote no {out.name}')
        return out


def edit_cfg(template, settings, rc_file):
    """Set KEY VALUE lines in a model config, uncommenting where needed.

    The template places its INCLUDE lines before the BITS_PER_PIXEL override,
    so the one INCLUDE kept here stays at the first INCLUDE position and every
    setting appended at the end follows it.
    """
    lines, seen, included = [], set(), False
    for raw in template.splitlines():
        active = raw.strip().lstrip('/').strip()
        key = active.split()[0] if active.split() else ''
        if key == 'INCLUDE':
            if not included:
                lines.append(f'INCLUDE {rc_file}')
                included = True
            continue
        if key in settings and key not in seen:
            lines.append(f'{key} {settings[key]}')
            seen.add(key)
            continue
        lines.append(raw)
    if not included:
        lines.append(f'INCLUDE {rc_file}')
    lines += [f'{k} {v}' for k, v in settings.items() if k not in seen]
    return '\n'.join(lines) + '\n'


def split_dsc(dsc, run_dir):
    data = dsc.read_bytes()
    if data[:4] != MAGIC or len(data) < 132:
        raise HarnessError(f'{dsc}: not a DSCF container')
    pps, payload = data[4:132], data[132:]
    be = lambda i: pps[i] * 256 + pps[i + 1]
    height, width, sh, sw, chunk = be(6), be(8), be(10), be(12), be(14)
    if not (sh and sw):
        raise HarnessError(f'{dsc}: zero slice size in PPS')
    # Whole slices: the last slice row carries its padding lines (§4.2.2).
    expected = chunk * sh * -(-height // sh) * -(-width // sw)
    if len(payload) != expected:
        raise HarnessError(f'{dsc}: payload {len(payload)} bytes, PPS implies {expected}')
    (run_dir / 'model.pps').write_bytes(pps)
    (run_dir / 'model.bin').write_bytes(payload)
    return run_dir / 'model.pps', run_dir / 'model.bin'


# --- dscdecode --------------------------------------------------------------

BUILDS = ('release', 'sanitize')


def dscdecode_binary():
    """DSCDECODE_BIN if set, else build/<DSCDECODE_BUILD or release>/dscdecode."""
    if os.environ.get('DSCDECODE_BIN'):
        return Path(os.environ['DSCDECODE_BIN'])
    build = os.environ.get('DSCDECODE_BUILD') or 'release'
    if build not in BUILDS:
        raise HarnessError(f'unknown build {build}; choose one of {", ".join(BUILDS)}')
    return REPO / 'build' / build / 'dscdecode'


def announce_binary(stream=sys.stdout):
    """Print the dscdecode path in use; fail early if it has not been built."""
    exe = dscdecode_binary()
    print(f'dscdecode: {exe}', file=stream, flush=True)
    if not exe.is_file():
        raise HarnessError(f'{exe} does not exist; build it with make')
    return exe


def dscdecode(pps, payload, out, readings=None, extra=()):
    exe = str(dscdecode_binary())
    args = [exe, '--stats', *extra]
    for k, v in (readings or {}).items():
        args += ['--reading', f'{k}={v}']
    args += [str(pps), str(payload), str(out)]
    p = subprocess.run(args, capture_output=True, text=True, timeout=600)
    stats = next((l for l in p.stderr.splitlines() if l.startswith('stats:')), '')
    return p.returncode, p.stderr.strip(), stats


def decoder_defaults():
    """The reading each switch defaults to, from dscdecode's usage listing."""
    exe = str(dscdecode_binary())
    p = subprocess.run([exe], capture_output=True, text=True, timeout=60)
    defaults = {}
    for line in p.stderr.splitlines():
        line = line.strip()
        if line.endswith(' (default)') and '=' in line:
            name, value = line[:-len(' (default)')].split('=', 1)
            defaults[name] = value
    return defaults


def reading_sets(all_readings, fixed, vary=None):
    """One reading set, or every combination of the switches in vary."""
    if not all_readings:
        return [dict(fixed)]
    names = vary or list(READINGS)
    for name in names:
        if name not in READINGS:
            raise HarnessError(f'unknown switch {name}')
    if 2 ** len(names) > 256:
        raise HarnessError(f'{2 ** len(names)} combinations; choose switches with --vary')
    return [dict(fixed, **dict(zip(names, v)))
            for v in itertools.product(*(READINGS[n] for n in names))]


def compare_decodes(run_dir, pps, payload, model_out, readings_list):
    results = []
    for n, readings in enumerate(readings_list):
        out = run_dir / f'dscdecode.{n}.ppm'
        code, err, stats = dscdecode(pps, payload, out, readings)
        if code:
            results.append(dict(readings=readings, error=err, stats=stats, match=False))
            continue
        r = compare_images(model_out, out)
        r.update(readings=readings, stats=stats)
        results.append(r)
    return results


def new_run_dir(label):
    root = Path(os.environ.get('DSCDECODE_RUNS', Path.home() / 'dsc-runs')) / 'compare'
    stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    return root / f'{stamp}-{label}'


def report(results, as_json):
    if as_json:
        print(json.dumps(results, indent=1))
        return
    for r in results:
        tag = ' '.join(f'{k}={v}' for k, v in r['readings'].items()) or 'defaults'
        text = f"decode error: {r['error']}" if 'error' in r else describe(r)
        print(f'  [{tag}] {text}')
        if r.get('stats'):
            print(f"      {r['stats']}")


def parse_readings(pairs):
    out = {}
    for pair in pairs or []:
        k, _, v = pair.partition('=')
        if k not in READINGS or v not in READINGS[k]:
            raise HarnessError(f'unknown reading {pair}')
        out[k] = v
    return out


# --- modes ------------------------------------------------------------------

def run_image(image, bpp=8.0, slices=1, slice_height=None, bp=False, line_buffer=None,
              readings_list=None, run_dir=None, bpc=8, version=1):
    """Model encodes image; model and dscdecode decode it. Returns a summary.
    line_buffer defaults to bpc + 1, at most 16 (the model's limit)."""
    label = f"{Path(image).stem}-bpc{bpc}-v1{version}-bpp{bpp:g}-s{slices}-bp{int(bp)}"
    run_dir = Path(run_dir) if run_dir else new_run_dir(label)
    model = Model(run_dir)
    line_buffer = line_buffer or min(bpc + 1, 16)
    dsc = model.encode(image, bpp, slices, slice_height, bp, line_buffer, bpc, version)
    source = model.check_source(image)
    model_out = model.decode(dsc)
    pps, payload = split_dsc(dsc, run_dir)
    results = compare_decodes(run_dir, pps, payload, model_out, readings_list or [{}])
    summary = dict(mode='image', image=str(image), bpc=bpc, dsc_version=f'1.{version}',
                   bpp=bpp, slices=slices, block_pred=int(bp), slice_height=slice_height,
                   line_buffer=line_buffer, source_check=source, run_dir=str(run_dir),
                   dscdecode=str(dscdecode_binary()), results=results)
    if model.encode_signal:
        summary['model_encode_signal'] = model.encode_signal
    (run_dir / 'result.json').write_text(json.dumps(summary, indent=1))
    return summary


def mode_image(a):
    summary = run_image(a.image, a.bpp, a.slices, a.slice_height, a.bp, a.line_buffer,
                        reading_sets(a.all_readings, parse_readings(a.reading), a.vary), a.run_dir,
                        a.bpc, a.dsc_version)
    results, run_dir = summary['results'], summary['run_dir']
    if not a.json:
        print(f'{a.image}: DSC 1.{a.dsc_version}, {a.bpc} bpc, bpp {a.bpp:g}, '
              f'{a.slices} slice(s)/line, BP {int(a.bp)}  [{run_dir}]')
        if summary.get('model_encode_signal'):
            print(f"  note: the model's encoder died from signal {summary['model_encode_signal']} "
                  'after writing its bitstream and reference picture')
    report(results, a.json)
    return 0 if any(r['match'] for r in results) else 1


def wrap_and_decode(pps, payload, run_dir, model):
    pps_b, pay_b = Path(pps).read_bytes(), Path(payload).read_bytes()
    if len(pps_b) != 128:
        raise HarnessError('PPS must be 128 bytes')
    dsc = run_dir / 'input.dsc'
    dsc.write_bytes(MAGIC + pps_b + pay_b)
    return model.decode(dsc)


def mode_bitstream(a):
    run_dir = Path(a.run_dir) if a.run_dir else new_run_dir(Path(a.payload).stem)
    model = Model(run_dir)
    model_out = wrap_and_decode(a.pps, a.payload, run_dir, model)
    results = compare_decodes(run_dir, a.pps, a.payload, model_out,
                              reading_sets(a.all_readings, parse_readings(a.reading), a.vary))
    (run_dir / 'result.json').write_text(json.dumps(dict(mode='bitstream', pps=str(a.pps),
                                                         payload=str(a.payload),
                                                         results=results), indent=1))
    if not a.json:
        print(f'{a.payload}  [{run_dir}]')
    report(results, a.json)
    return 0 if any(r['match'] for r in results) else 1


def mode_discriminators(a):
    root = REPO / 'tests' / 'discriminators'
    manifest = json.loads((root / 'manifest.json').read_text())
    names = a.names or list(manifest)
    status, summary = 0, {}
    # A prediction holds only under the readings the input was built with
    # (`assumes`). Where those differ from the decoder's defaults, which
    # follow the model comparisons, a verdict of neither is inconclusive.
    defaults = decoder_defaults()
    for name in names:
        run_dir = new_run_dir(name)
        model = Model(run_dir)
        entry = manifest[name]
        verdicts = {}
        try:
            model_out = wrap_and_decode(root / f'{name}.pps', root / f'{name}.bin', run_dir, model)
        except HarnessError as e:
            # The model rejected the input: a verdict of neither.
            reason = (str(e).strip().splitlines() or ['no message'])[-1][:200]
            verdicts = {r: dict(match=False, model_error=f'model decode failed: {reason}')
                        for r in own_readings(entry)}
        else:
            for reading in own_readings(entry):
                verdicts[reading] = compare_images(model_out, root / f'{name}.{reading}.expected.ppm')
        supported = [r for r, v in verdicts.items() if v['match']]
        # Readings with the same prediction count as one outcome (an input
        # need not separate all three readings of a three-way question).
        shas = entry.get('readings', {})
        outcomes = {shas.get(r, {}).get('expected_sha256', r) for r in supported}
        stale = {k: v for k, v in entry.get('assumes', {}).items() if defaults.get(k) != v}
        superseded = entry.get('superseded_by')
        summary[name] = dict(question=entry['question'], supported=supported,
                             verdicts=verdicts, run_dir=str(run_dir), stale_assumptions=stale,
                             superseded_by=superseded)
        matches = ', '.join(supported) if supported else 'NEITHER prediction'
        if superseded:
            print(f"{name} ({entry['question']}): SUPERSEDED by {superseded}; "
                  f"not part of the verdict  [{run_dir}]")
            print(f'  for the record, model output matches {matches}')
        else:
            print(f"{name} ({entry['question']}): model output matches {matches}  [{run_dir}]")
        for reading, v in verdicts.items():
            print(f'  prediction {reading}: {describe(v)}')
        if superseded:
            continue
        if len(outcomes) != 1:
            if stale and not supported:
                print('  inconclusive: built assuming ' +
                      ', '.join(f'{k}={v}' for k, v in stale.items()) +
                      ', which the decoder defaults no longer use')
            else:
                status = 1
    if a.json:
        print(json.dumps(summary, indent=1))
    return status


def own_readings(entry):
    """The readings of its question an input has predictions for. A reading
    added after an input was decoded by the model has none."""
    return list(entry.get('readings') or READINGS[entry['question']])


def mode_self_test(a):
    if not os.environ.get('DSCDECODE_MODEL_BIN'):
        print('SKIP: DSCDECODE_MODEL_BIN is not set')
        return SKIP
    run_dir = new_run_dir('self-test')
    run_dir.mkdir(parents=True)
    w, h = 192, 108
    image = run_dir / 'ramp.ppm'
    image.write_bytes(f'P6\n{w} {h}\n255\n'.encode() + bytes(
        v for y in range(h) for x in range(w)
        for v in ((x * 4 + y) % 256, (y * 2 + x // 3) % 256, (255 - x) % 256)))
    args = argparse.Namespace(image=str(image), bpp=8.0, slices=1, slice_height=108, bp=False,
                              line_buffer=9, bpc=8, dsc_version=1, reading=[], all_readings=False, vary=None,
                              run_dir=str(run_dir / 'run'), json=False)
    return mode_image(args)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--self-test', action='store_true')
    ap.add_argument('--json', action='store_true')
    ap.add_argument('--build', choices=BUILDS, default=None,
                    help='dscdecode build to use (default: DSCDECODE_BUILD, else release)')
    sub = ap.add_subparsers(dest='mode')
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--reading', action='append', metavar='NAME=VALUE')
    common.add_argument('--all-readings', action='store_true',
                        help='decode with every combination of the switches in --vary')
    common.add_argument('--vary', type=lambda s: s.split(','), default=None,
                        metavar='NAME,...', help='switches --all-readings varies (default: all)')
    common.add_argument('--run-dir')
    common.add_argument('--json', action='store_true')
    im = sub.add_parser('image', parents=[common])
    im.add_argument('image')
    im.add_argument('--bpp', type=float, default=8.0)
    im.add_argument('--slices', type=int, default=1, help='slices per line')
    im.add_argument('--slice-height', type=int, default=None,
                    help='default: the value in test_dsc_1_1.cfg')
    im.add_argument('--bp', type=int, choices=(0, 1), default=0)
    im.add_argument('--bpc', type=int, default=8, help='bits per component (rc_<bpc>bpc_* configs)')
    im.add_argument('--dsc-version', type=int, choices=(1, 2), default=1,
                    help='DSC_VERSION_MINOR (default 1)')
    im.add_argument('--line-buffer', type=int, default=None, help='default: bpc + 1, at most 16')
    bs = sub.add_parser('bitstream', parents=[common])
    bs.add_argument('pps')
    bs.add_argument('payload')
    ds = sub.add_parser('discriminators')
    ds.add_argument('names', nargs='*')
    ds.add_argument('--json', action='store_true')
    a = ap.parse_args()
    if a.build:
        os.environ['DSCDECODE_BUILD'] = a.build
    if not os.environ.get('DSCDECODE_MODEL_BIN') and (a.self_test or a.mode):
        print('SKIP: DSCDECODE_MODEL_BIN is not set')
        return SKIP
    try:
        if a.self_test or a.mode:
            announce_binary(sys.stderr if a.json else sys.stdout)
        if a.self_test:
            return mode_self_test(a)
        if a.mode == 'image':
            return mode_image(a)
        if a.mode == 'bitstream':
            return mode_bitstream(a)
        if a.mode == 'discriminators':
            return mode_discriminators(a)
        ap.print_help()
        return 2
    except HarnessError as e:
        print(f'ERROR: {e}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
